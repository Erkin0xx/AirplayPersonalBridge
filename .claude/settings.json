{
  "permissions": {
    "allow": [
      "Bash(swift build *)",
      "Bash(swift run *)",
      "Bash(swift test *)",
      "Bash(git *)",
      "Bash(brew install *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python *)",
      "Bash(shairport-sync*)",
      "Bash(source *)",
      "Edit",
      "Write",
      "Read"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/auto-commit.sh\"",
            "timeout": 120,
            "statusMessage": "Commit et push automatiques…"
          }
        ]
      }
    ]
  }
}
